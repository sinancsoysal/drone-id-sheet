{
  "name": "Print Drone IDs",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "runServices": ["app", "mailpit"],
  "workspaceFolder": "/workspaces/printdroneids",
  "remoteUser": "node",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code", "ms-playwright.playwright", "stripe.vscode-stripe"]
    }
  }
}
