{
  "name": "printdroneids",
  "version": "1.0.0",
  "description": "Turn UK CAA flyer ID and operator ID documents into a printable sheet of wallet cards and drone labels.",
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "label-chars": "tsx scripts/make-label-chars.ts",
    "social": "tsx scripts/make-social.ts",
    "guide": "UPDATE_GUIDE=1 playwright test e2e/guide.spec.ts --project=desktop",
    "dev:netlify": "netlify dev",
    "stripe:listen": "stripe listen --events checkout.session.completed,checkout.session.async_payment_succeeded,checkout.session.async_payment_failed,checkout.session.expired --forward-to localhost:8888/api/stripe-webhook"
  },
  "license": "MIT",
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "nodemailer": "^10.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@netlify/blobs": "^11.1.4",
    "@netlify/functions": "^6.0.2",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "stripe": "^23.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/sinancsoysal/drone-id-sheet.git"
  },
  "engines": {
    "node": ">=22"
  }
}
